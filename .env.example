# offline = deterministic, no key, no network (default). anthropic = use Claude.
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
ROUTER_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
# Live web tools (Open-Meteo, AwesomeAPI, DuckDuckGo). false = tools return error "disabled".
ENABLE_WEB_TOOLS=true
# Optional fixed "today" (YYYY-MM-DD) for reproducible settlement forecasts.
GETNET_TODAY=
LOG_LEVEL=INFO
